{
  "_id": "NotificationConfig:test-user-multiple-conditions",
  "notificationRules": [
    {
      "label": "Child of project 1 or 3 created",
      "notificationType": "ENTITY_CHANGE",
      "entityType": "Child",
      "changeType": ["created"],
      "conditions": {"$or": [{"name": "Test Child"}, {"projectNumber": {"$in": ["1", "3"]}}]},
      "enabled": true
    }
  ],
  "channels": {
    "push": false,
    "email": false
  }
}

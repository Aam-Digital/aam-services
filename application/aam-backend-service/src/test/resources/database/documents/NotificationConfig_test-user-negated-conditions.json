{
  "_id": "NotificationConfig:test-user-negated-conditions",
  "notificationRules": [
    {
      "label": "Any other Child created",
      "notificationType": "ENTITY_CHANGE",
      "entityType": "Child",
      "changeType": ["created"],
      "conditions": {"$or": [{"name": {"$not": {"$eq": "Test Child"}}}]},
      "enabled": true
    }
  ],
  "channels": {
    "push": false,
    "email": false
  }
}

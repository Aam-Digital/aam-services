# Instance-specific values, secrets and feature toggles of an aam-backend-service deployment.
# A setting with the same value on every deployment gets its default in application.yaml instead:
# ndb-setup copies this template only once, when the backend is enabled, so a key added here later
# does not reach existing instances.

#APPLICATION_BASEURL=<normally set via docker-compose env>
CRYPTO_CONFIGURATION_SECRET=
SERVER_SERVLET_CONTEXT_PATH=/api
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUERURI=
# Keycloak client of the Aam Digital frontend; its users may use the reporting API without API client scopes
AAMSECURITY_FRONTENDCLIENTID=app
SPRING_SERVLET_MULTIPART_MAXFILESIZE=5MB
FEATURES_REPORTING_ENABLED=true
FEATURES_SKILLAPI_MODE=disabled
FEATURES_EXPORTAPI_ENABLED=true
FEATURES_NOTIFICATIONAPI_ENABLED=false
FEATURES_NOTIFICATIONAPI_MODE=firebase
# Notification email is sent as soon as FEATURES_NOTIFICATIONAPI_ENABLED=true and SPRING_MAIL_HOST,
# NOTIFICATION_EMAIL_FROM and the KEYCLOAK_* settings below are all set. Leave SPRING_MAIL_HOST empty to
# not send notification emails.
# Sender address only. The display name in front of it and the subject prefix are managed in the
# templates/{locale}/notification/email-branding.properties file (mount an override to customize per deployment).
NOTIFICATION_EMAIL_FROM=notifications@your-instance.org
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=
# Use SSL_ENABLE=true for port 465 (implicit SSL/SMTPS)
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=
# Use STARTTLS_ENABLE=true for port 587 (explicit TLS upgrade)
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=
FEATURES_THIRDPARTYAUTHENTICATION_ENABLED=false
KEYCLOAK_SERVERURL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENTID=
KEYCLOAK_CLIENTSECRET=
NOTIFICATIONFIREBASECONFIGURATION_CREDENTIALFILEBASE64=
SKILLLABAPICLIENTCONFIGURATION_APIKEY=
SKILLLABAPICLIENTCONFIGURATION_PROJECTID=
SKILLLABAPICLIENTCONFIGURATION_BASEPATH=
SKILLLABAPICLIENTCONFIGURATION_RESPONSETIMEOUTINSECONDS=15
AAMREPLICATIONBACKENDCLIENTCONFIGURATION_BASEPATH=
AAMREPLICATIONBACKENDCLIENTCONFIGURATION_BASICAUTHUSERNAME=
AAMREPLICATIONBACKENDCLIENTCONFIGURATION_BASICAUTHPASSWORD=
AAMREPLICATIONBACKENDCLIENTCONFIGURATION_RESPONSETIMEOUTINSECONDS=10
# Set via docker-compose environment override to use ${INSTANCE_NAME}-database (container_name),
# avoiding alias collisions on the shared external_web network across instances.
# See https://github.com/Aam-Digital/ndb-setup/issues/94
#COUCHDBCLIENTCONFIGURATION_BASEPATH=http://couchdb-with-permissions:5984
COUCHDBCLIENTCONFIGURATION_BASICAUTHUSERNAME=
COUCHDBCLIENTCONFIGURATION_BASICAUTHPASSWORD=
SQSCLIENTCONFIGURATION_BASICAUTHUSERNAME=
SQSCLIENTCONFIGURATION_BASICAUTHPASSWORD=
AAM_RENDER_API_CLIENT_CONFIGURATION_BASE_PATH=
AAM_RENDER_API_CLIENT_CONFIGURATION_AUTH_CONFIG_CLIENT_ID=
AAM_RENDER_API_CLIENT_CONFIGURATION_AUTH_CONFIG_CLIENT_SECRET=
AAM_RENDER_API_CLIENT_CONFIGURATION_AUTH_CONFIG_TOKEN_ENDPOINT=
AAM_RENDER_API_CLIENT_CONFIGURATION_AUTH_CONFIG_GRANT_TYPE=
AAM_RENDER_API_CLIENT_CONFIGURATION_AUTH_CONFIG_SCOPE=
SENTRY_AUTH_TOKEN=
SENTRY_DSN=
SENTRY_SERVER_NAME=
